---
import fs from 'node:fs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — PEACEMINUSONE archive` : 'PEACEMINUSONE — unofficial fan archive';
const pageDesc = description ?? '지드래곤의 브랜드 PEACEMINUSONE 비공식 팬 아카이브 — 전시 · 제품 · minus one의 철학.';

// 로고 폴백: public/assets/brand/logo.png가 있으면 이미지, 없으면 텍스트 로고
const hasLogo = fs.existsSync(new URL('../../public/assets/brand/logo.png', import.meta.url));

const base = import.meta.env.BASE_URL; // "/pmo-fan-archive/"
const baseNoSlash = base.replace(/\/$/, '');
const ogImage = new URL(`${baseNoSlash}/assets/brand/og.jpg`, Astro.site ?? 'https://yeodh10.github.io').href;

const nav = [
  { href: `${baseNoSlash}/archive`, label: 'Archive' },
  { href: `${baseNoSlash}/exhibition`, label: 'Exhibition' },
  { href: `${baseNoSlash}/timeline`, label: 'Timeline' },
  { href: `${baseNoSlash}/philosophy`, label: 'Philosophy' },
  { href: `${baseNoSlash}/shop`, label: 'Shop' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/png" href={`${baseNoSlash}/assets/brand/favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PEACEMINUSONE archive" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Cormorant+Garamond:ital,wght@1,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 사이트 모드(aloof | classic) — 페인트 전에 html에 적용해 깜빡임 없이. ?mode= 로 강제 가능.
      (function () {
        var q = new URLSearchParams(location.search).get('mode');
        var v = q || localStorage.getItem('pmo:mode') || localStorage.getItem('pmo:hero') || 'aloof';
        if (v !== 'classic') v = 'aloof';
        document.documentElement.dataset.mode = v;
        if (q) localStorage.setItem('pmo:mode', v);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href={base} class="logo" aria-label="PEACEMINUSONE archive home">
        {hasLogo
          ? <img src={`${baseNoSlash}/assets/brand/logo.png`} alt="PEACEMINUSONE" class="logo-img" />
          : <span class="logo-text">PEACEMINUSONE</span>}
      </a>
      <nav class="site-nav" aria-label="main">
        {nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="t-meta">unofficial fan archive — not affiliated with peaceminusone</p>
      <div class="mode-switch" aria-label="site mode">
        <button type="button" class="mode-opt" data-set-mode="aloof">aloof</button>
        <button type="button" class="mode-opt" data-set-mode="classic">classic</button>
      </div>
      <p class="t-meta footer-year">personal study / portfolio only</p>
    </footer>
    <script is:inline>
      // 모드 토글 — 히어로·푸터 어디의 버튼이든 같은 키에 저장하고 새로고침
      document.querySelectorAll('[data-set-mode]').forEach(function (b) {
        b.addEventListener('click', function () {
          localStorage.setItem('pmo:mode', b.getAttribute('data-set-mode') === 'classic' ? 'classic' : 'aloof');
          location.reload();
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    /* 본문 위로 떠 있되 존재감은 낮게 */
    background: linear-gradient(to bottom, rgba(12, 12, 12, 0.85), rgba(12, 12, 12, 0));
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 22px;
    width: auto;
    /* 다크 배경 위 로고 — 원본이 어두우면 사용자 쪽에서 흰 버전 저장 */
  }

  .logo-text {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .nav-link {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg);
  }

  /* 페이지 진입 페이드 — 다크 베이스라 전환이 한 호흡처럼 이어진다 */
  main {
    animation: page-enter 0.55s ease both;
  }

  @keyframes page-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    main { animation: none; }
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    justify-content: space-between;
    padding: var(--space-3) var(--gutter);
    border-top: 1px solid var(--line);
  }

  .footer-year {
    color: var(--faint);
  }

  /* 모드 토글(푸터) — 결정용, 존재감 낮게 */
  .mode-switch {
    display: flex;
    gap: 0.9rem;
    opacity: 0.45;
    transition: opacity 0.3s ease;
  }
  .mode-switch:hover { opacity: 1; }
  .mode-opt {
    background: none; border: none; cursor: pointer;
    font-family: inherit; font-size: var(--text-xs);
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); padding: 0;
  }
  .mode-opt:hover { color: var(--fg); }
  .mode-opt:focus-visible { color: var(--fg); outline: 1px solid var(--line); outline-offset: 3px; }
  :global(html[data-mode='aloof']) .mode-opt[data-set-mode='aloof'],
  :global(html[data-mode='classic']) .mode-opt[data-set-mode='classic'] { color: var(--fg); }

  /* 모바일: 로고/내비 2단 헤더 */
  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.6rem;
      background: linear-gradient(to bottom, rgba(12, 12, 12, 0.92) 60%, rgba(12, 12, 12, 0));
    }

    .logo-img {
      height: 16px;
    }

    .logo-text {
      letter-spacing: 0.28em;
      font-size: 0.6875rem;
    }

    .site-nav {
      gap: 1rem;
    }
  }
</style>
